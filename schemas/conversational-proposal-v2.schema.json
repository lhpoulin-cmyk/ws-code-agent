{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docwriter/conversational-proposal-v2.schema.json",
  "title": "Doc Writer conversational proposal v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["integrity_findings", "conversational_proposal"],
  "properties": {
    "integrity_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "detail", "related_passage", "blocks_approval", "resolution_authority"],
        "properties": {
          "category": {"type": "string", "enum": ["confirmed_conflict", "apparent_conflict_requiring_authority_review", "unsupported_claim", "ambiguity", "no_material_issue_found"]},
          "detail": {"type": "string", "minLength": 1, "maxLength": 4000},
          "related_passage": {"type": "string", "maxLength": 1000},
          "blocks_approval": {"type": "boolean"},
          "resolution_authority": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "conversational_proposal": {"type": "string", "minLength": 1, "maxLength": 12000}
  }
}
